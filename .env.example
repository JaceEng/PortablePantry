# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file to Git.

# --- Supabase (database and authentication) ---
# Found in the Supabase dashboard under Project Settings -> API
SUPABASE_URL=
SUPABASE_KEY=

# --- Ollama (recipe generation) ---
# Default local Ollama address
OLLAMA_URL=http://localhost:11434
# Model name used for recipe generation (must be pulled first: ollama pull <model>)
OLLAMA_MODEL=llama3.1

# --- Flask ---
FLASK_SECRET_KEY=
FLASK_DEBUG=1
PORT=5000