# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file to Git.

# --- Supabase (database and authentication) ---
# Found in the Supabase dashboard under Project Settings -> API
SUPABASE_URL=
SUPABASE_KEY=

# --- Ollama (recipe generation) ---
# Default local Ollama address
OLLAMA_URL=http://localhost:11434
# Model name used for recipe generation (must be pulled first: ollama pull <model>)
OLLAMA_MODEL=llama3.1
# Smaller models are much faster on a laptop, e.g. llama3.2 (3B): ollama pull llama3.2
# How many recipes each Generate request asks for (fewer = faster)
OLLAMA_RECIPE_COUNT=3

# --- TheMealDB (recipe search) ---
# "1" is the free test key. Supporters get a personal key.
MEALDB_API_KEY=1

# --- Flask ---
FLASK_SECRET_KEY=
FLASK_DEBUG=1
PORT=5000